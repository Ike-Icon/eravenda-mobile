diff -ruN a/backend/app/notifications.py b/backend/app/notifications.py
--- a/backend/app/notifications.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/notifications.py	2026-11-06 07:34:56.334078319 +0000
@@ -0,0 +1,153 @@
+"""Order notifications: decides WHO is told, through WHICH channel, honouring each user's preferences.
+
+Channels
+  push  - push.notify_users (Expo), background thread
+  email - email_utils.send_email, background thread
+
+Preferences (models.NotificationPreference, all default to ON when a user has no row):
+  order_updates_email / order_updates_push : buyer, status changes (processing, dispatched, delivered, cancelled)
+  seller_orders_push                       : seller, new order / payment / buyer cancellation
+
+Transactional emails that already existed (payment confirmation to buyer and seller, receipts) are NOT
+controlled by these settings and are untouched. Nothing here ever raises: a failed notification must not
+fail the order request that triggered it.
+"""
+
+import logging
+import threading
+from dataclasses import dataclass
+
+from . import models, push
+from .email_utils import SITE_URL, send_email
+
+logger = logging.getLogger("eravenda.notifications")
+
+
+@dataclass(frozen=True)
+class Prefs:
+    order_updates_email: bool = True
+    order_updates_push: bool = True
+    seller_orders_push: bool = True
+
+
+def get_prefs(db, user_id: str) -> Prefs:
+    row = db.query(models.NotificationPreference).filter(models.NotificationPreference.user_id == user_id).first()
+    if not row:
+        return Prefs()
+    return Prefs(row.order_updates_email, row.order_updates_push, row.seller_orders_push)
+
+
+# ---------- wording ----------
+
+_PUSH_TEXT = {
+    "paid": "Payment received. The seller will start preparing your order.",
+    "processing": "The seller is preparing your order.",
+    "shipped": "Your order has been dispatched.",
+    "delivered": "Your order was delivered. Tap to rate your items.",
+    "cancelled": "Your order was cancelled.",
+    "refunded": "Your order was refunded.",
+}
+
+_EMAIL_HEADLINE = {
+    "processing": ("is being prepared", "The seller has accepted your order and is getting it ready."),
+    "shipped": ("has been dispatched", "Your order is on its way."),
+    "delivered": ("was delivered", "Your order has been marked as delivered. We hope you love it! You can rate your items in the app."),
+    "cancelled": ("was cancelled", "Your order was cancelled. If you already paid online, contact support about your refund."),
+}
+
+# "paid" is covered by the existing payment-confirmation email, so it has a push but no status email.
+EMAIL_STATUSES = tuple(_EMAIL_HEADLINE)
+
+
+def _status(order) -> str:
+    return order.status.value if hasattr(order.status, "value") else str(order.status)
+
+
+def _email_body(first_name: str, order, status: str) -> tuple[str, str]:
+    verb, lead = _EMAIL_HEADLINE[status]
+    store = order.store.store_name if order.store else "the seller"
+    lines = [f"- {i.product_name} x{i.quantity} — GHS {float(i.line_total):.2f}" for i in order.items] or ["- Order items"]
+    extra = ""
+    if status == "shipped":
+        if order.shipping_carrier:
+            extra += f"Carrier: {order.shipping_carrier}\n"
+        if order.tracking_number:
+            extra += f"Tracking number: {order.tracking_number}\n"
+        if order.estimated_delivery:
+            extra += f"Estimated delivery: {order.estimated_delivery:%d %b %Y}\n"
+        if extra:
+            extra += "\n"
+    note = f"Note from the seller: {order.seller_note}\n\n" if getattr(order, "seller_note", None) else ""
+    body = (
+        f"Hi {first_name},\n\n"
+        f"Your order {order.order_number} from {store} {verb}.\n{lead}\n\n"
+        f"{chr(10).join(lines)}\n\n"
+        f"{extra}{note}"
+        f"Track your order any time:\n{SITE_URL}/orders.html\n\n"
+        "To stop these emails, open the EraVenda app and go to Account > Notifications.\n"
+    )
+    return f"Your EraVenda order {order.order_number} {verb}", body
+
+
+def _send_email_async(to: str, subject: str, body: str) -> None:
+    def run():
+        try:
+            send_email(to=to, subject=subject, body=body)
+        except Exception:
+            logger.exception("Order status email failed for %s", to)
+
+    threading.Thread(target=run, daemon=True).start()
+
+
+# ---------- events ----------
+
+def order_status_changed(db, order) -> None:
+    """A seller (or admin) changed the order status: tell the buyer by push and/or email."""
+    try:
+        status = _status(order)
+        prefs = get_prefs(db, order.buyer_id)
+        if prefs.order_updates_push and status in _PUSH_TEXT:
+            push.notify_users(db, [order.buyer_id], f"Order #{order.order_number}", _PUSH_TEXT[status],
+                              {"type": "order", "audience": "buyer", "order_id": order.id})
+        if prefs.order_updates_email and status in EMAIL_STATUSES:
+            buyer = db.query(models.User).filter(models.User.id == order.buyer_id).first()
+            if buyer and buyer.email:
+                first = (buyer.full_name or "").strip().split(" ")[0] or "there"
+                subject, body = _email_body(first, order, status)
+                _send_email_async(buyer.email, subject, body)
+    except Exception:
+        logger.exception("Could not notify buyer about order %s", getattr(order, "id", "?"))
+
+
+def payment_confirmed(db, order) -> None:
+    """Payment succeeded: push the buyer and the seller (their emails already exist in payments.py)."""
+    try:
+        if get_prefs(db, order.buyer_id).order_updates_push:
+            push.notify_users(db, [order.buyer_id], f"Order #{order.order_number}", _PUSH_TEXT["paid"],
+                              {"type": "order", "audience": "buyer", "order_id": order.id})
+        new_order_for_seller(db, order, paid=True)
+    except Exception:
+        logger.exception("Could not notify about payment for order %s", getattr(order, "id", "?"))
+
+
+def new_order_for_seller(db, order, paid: bool = False) -> None:
+    try:
+        owner_id = order.store.owner_id if order.store else None
+        if not owner_id or not get_prefs(db, owner_id).seller_orders_push:
+            return
+        kind = "wholesale order" if getattr(order, "order_type", "retail") == "wholesale" else "order"
+        title = f"Order #{order.order_number} paid" if paid else f"New {kind}"
+        body = "Payment confirmed. You can start processing it." if paid else f"Order #{order.order_number} is waiting for you."
+        push.notify_users(db, [owner_id], title, body, {"type": "order", "audience": "seller", "order_id": order.id})
+    except Exception:
+        logger.exception("Could not notify seller about order %s", getattr(order, "id", "?"))
+
+
+def buyer_cancelled(db, order) -> None:
+    try:
+        owner_id = order.store.owner_id if order.store else None
+        if owner_id and get_prefs(db, owner_id).seller_orders_push:
+            push.notify_users(db, [owner_id], f"Order #{order.order_number} cancelled", "The buyer cancelled this order.",
+                              {"type": "order", "audience": "seller", "order_id": order.id})
+    except Exception:
+        logger.exception("Could not notify seller about cancellation of %s", getattr(order, "id", "?"))
diff -ruN a/backend/app/push.py b/backend/app/push.py
--- a/backend/app/push.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/push.py	2026-11-06 07:34:56.333154270 +0000
@@ -0,0 +1,94 @@
+"""Push notifications through Expo's push service (best-effort).
+
+A failed or slow push must never break the request that triggered it, so:
+  * tokens are looked up inside the request (one fast query),
+  * the HTTP call to Expo happens on a short-lived background thread,
+  * every public function swallows and logs its own errors.
+Set PUSH_NOTIFICATIONS_ENABLED=false to switch it off, and (optionally) EXPO_ACCESS_TOKEN
+if you turned on "enhanced push security" in your Expo account.
+"""
+
+import logging
+import os
+import re
+import threading
+from typing import Iterable, Optional
+
+import httpx  # type: ignore[reportMissingImports]
+
+from . import models
+
+logger = logging.getLogger("eravenda.push")
+
+EXPO_PUSH_URL = "https://exp.host/--/api/v2/push/send"
+_TOKEN_RE = re.compile(r"^(Exponent|Expo)PushToken\[[^\]\s]+\]$")
+_CHUNK = 100  # Expo accepts up to 100 messages per request
+
+
+def enabled() -> bool:
+    return os.getenv("PUSH_NOTIFICATIONS_ENABLED", "true").strip().lower() not in ("0", "false", "no", "off")
+
+
+def is_valid_token(token: Optional[str]) -> bool:
+    return bool(token and len(token) <= 200 and _TOKEN_RE.match(token))
+
+
+def _headers() -> dict:
+    headers = {"Accept": "application/json", "Content-Type": "application/json"}
+    access = os.getenv("EXPO_ACCESS_TOKEN", "").strip()
+    if access:
+        headers["Authorization"] = f"Bearer {access}"
+    return headers
+
+
+def _prune(tokens: list[str]) -> None:
+    """Forget tokens Expo says no longer exist (app uninstalled, token rotated)."""
+    from .database import SessionLocal
+
+    db = SessionLocal()
+    try:
+        db.query(models.DeviceToken).filter(models.DeviceToken.token.in_(tokens)).delete(synchronize_session=False)
+        db.commit()
+    except Exception:
+        db.rollback()
+        logger.exception("Could not prune dead push tokens")
+    finally:
+        db.close()
+
+
+def _send(messages: list[dict]) -> None:
+    dead: list[str] = []
+    try:
+        with httpx.Client(timeout=10.0) as client:
+            for start in range(0, len(messages), _CHUNK):
+                chunk = messages[start:start + _CHUNK]
+                res = client.post(EXPO_PUSH_URL, json=chunk, headers=_headers())
+                res.raise_for_status()
+                tickets = res.json().get("data", [])
+                for message, ticket in zip(chunk, tickets):
+                    if ticket.get("status") == "error" and (ticket.get("details") or {}).get("error") == "DeviceNotRegistered":
+                        dead.append(message["to"])
+    except Exception:
+        logger.exception("Expo push request failed")
+    if dead:
+        _prune(dead)
+
+
+def notify_users(db, user_ids: Iterable[str], title: str, body: str, data: Optional[dict] = None) -> None:
+    """Queue a notification for every device registered to these users. Never raises."""
+    try:
+        if not enabled():
+            return
+        ids = [uid for uid in set(user_ids) if uid]
+        if not ids:
+            return
+        tokens = [row[0] for row in db.query(models.DeviceToken.token).filter(models.DeviceToken.user_id.in_(ids)).all()]
+        if not tokens:
+            return
+        messages = [
+            {"to": token, "title": title, "body": body, "data": data or {}, "sound": "default", "channelId": "orders"}
+            for token in tokens
+        ]
+        threading.Thread(target=_send, args=(messages,), daemon=True).start()
+    except Exception:
+        logger.exception("Could not queue push notification")
