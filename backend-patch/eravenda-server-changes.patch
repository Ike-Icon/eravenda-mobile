+"""Unit tests for notifications.py (who gets told, through which channel). No database or network.
+
+    SECRET_KEY=a-long-random-test-secret-of-32-chars-or-more python -m pytest tests/test_notifications.py -q
+"""
+import os
+from datetime import datetime
+from types import SimpleNamespace as NS
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-notification-tests-0123456789")
+
+from app import notifications  # noqa: E402
+
+
+def _order(status="shipped", **kw):
+    base = dict(
+        id="o1", order_number="ORD-1", buyer_id="buyer", status=NS(value=status), order_type="retail",
+        store=NS(store_name="Kofi Shop", owner_id="seller"),
+        items=[NS(product_name="Shoes", quantity=2, line_total=100)],
+        shipping_carrier="Bolt", tracking_number="T123", estimated_delivery=datetime(2026, 12, 1), seller_note=None,
+    )
+    base.update(kw)
+    return NS(**base)
+
+
+class _Db:
+    """Only the buyer lookup in order_status_changed uses the db; preferences are monkeypatched."""
+    def query(self, *_a, **_k):
+        return self
+
+    def filter(self, *_a, **_k):
+        return self
+
+    def first(self):
+        return NS(email="ama@example.com", full_name="Ama Mensah")
+
+
+def _spy(monkeypatch, prefs):
+    pushes, emails = [], []
+    monkeypatch.setattr(notifications, "get_prefs", lambda _db, _uid: prefs)
+    monkeypatch.setattr(notifications.push, "notify_users", lambda _db, ids, title, body, data=None: pushes.append((list(ids), title, body, data)))
+    monkeypatch.setattr(notifications, "_send_email_async", lambda to, subject, body: emails.append((to, subject, body)))
+    return pushes, emails
+
+
+def test_shipped_sends_push_and_email_with_tracking(monkeypatch):
+    pushes, emails = _spy(monkeypatch, notifications.Prefs())
+    notifications.order_status_changed(_Db(), _order("shipped"))
+    assert pushes and pushes[0][0] == ["buyer"] and pushes[0][3]["order_id"] == "o1"
+    to, subject, body = emails[0]
+    assert to == "ama@example.com" and "dispatched" in subject
+    assert "Hi Ama," in body and "Tracking number: T123" in body and "Carrier: Bolt" in body
+    assert "Account > Notifications" in body
+
+
+def test_email_off_still_pushes(monkeypatch):
+    pushes, emails = _spy(monkeypatch, notifications.Prefs(order_updates_email=False))
+    notifications.order_status_changed(_Db(), _order("delivered"))
+    assert pushes and not emails
+
+
+def test_push_off_still_emails(monkeypatch):
+    pushes, emails = _spy(monkeypatch, notifications.Prefs(order_updates_push=False))
+    notifications.order_status_changed(_Db(), _order("processing"))
+    assert emails and not pushes
+
+
+def test_paid_status_pushes_but_has_no_status_email(monkeypatch):
+    pushes, emails = _spy(monkeypatch, notifications.Prefs())
+    notifications.order_status_changed(_Db(), _order("paid"))
+    assert pushes and not emails  # the existing payment-confirmation email covers "paid"
+
+
+def test_seller_pushes_respect_their_switch(monkeypatch):
+    pushes, _ = _spy(monkeypatch, notifications.Prefs(seller_orders_push=False))
+    notifications.new_order_for_seller(_Db(), _order("pending"))
+    notifications.buyer_cancelled(_Db(), _order("cancelled"))
+    assert not pushes
+    pushes, _ = _spy(monkeypatch, notifications.Prefs())
+    notifications.new_order_for_seller(_Db(), _order("pending", order_type="wholesale"))
+    assert pushes[0][0] == ["seller"] and "wholesale" in pushes[0][1]
+
+
+def test_payment_confirmed_notifies_both_sides(monkeypatch):
+    pushes, _ = _spy(monkeypatch, notifications.Prefs())
+    notifications.payment_confirmed(_Db(), _order("paid"))
+    assert sorted(p[0][0] for p in pushes) == ["buyer", "seller"]
