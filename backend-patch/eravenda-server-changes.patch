+"""End-to-end checks for reporting and blocking (routers/moderation.py).
+
+Runs against a real PostgreSQL, like tests/test_wholesale.py:
+
+    DATABASE_URL=postgresql://localhost:5432/eravenda_test SECRET_KEY=test \
+        python -m pytest tests/test_moderation.py -q
+
+NOTE: written against the real routes and models but not yet executed (the authoring sandbox had no PostgreSQL).
+"""
+import os
+import uuid
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import text
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-moderation-tests-0123456789")
+
+from app.database import engine  # noqa: E402
+from app.main import app  # noqa: E402
+
+PWD = "Passw0rd!123"
+
+
+def _sql(query, **params):
+    with engine.begin() as conn:
+        return conn.execute(text(query), params)
+
+
+@pytest.fixture(scope="module")
+def client():
+    with TestClient(app, base_url="http://testserver/api") as c:
+        yield c
+
+
+def _register(client, name):
+    email = f"{name}-{uuid.uuid4().hex[:6]}@example.com"
+    r = client.post("/auth/register", json={"full_name": name, "email": email, "password": PWD})
+    assert r.status_code in (200, 201), r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}, r.json()["user"]["id"], email
+
+
+def _relogin(client, email, role, user_id):
+    _sql("UPDATE users SET role = :r WHERE id = :i", r=role, i=user_id)
+    r = client.post("/auth/login", data={"username": email, "password": PWD})
+    assert r.status_code == 200, r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}
+
+
+@pytest.fixture(scope="module")
+def world(client):
+    admin_h, admin_id, admin_email = _register(client, "Admin")
+    admin_h = _relogin(client, admin_email, "admin", admin_id)
+    cat = client.post("/categories", headers=admin_h, json={"name": f"Cat {uuid.uuid4().hex[:4]}"})
+    assert cat.status_code == 201, cat.text
+
+    sh, suid, semail = _register(client, "Seller")
+    r = client.post("/stores", headers=sh, json={"store_name": f"Shop {uuid.uuid4().hex[:4]}", "region": "Bono", "city": "Sunyani"})
+    assert r.status_code == 201, r.text
+    store_id = r.json()["id"]
+    _sql("UPDATE stores SET status = 'approved' WHERE id = :i", i=store_id)
+    sh = _relogin(client, semail, "seller", suid)
+    p = client.post("/products", headers=sh, json={"name": f"Reported {uuid.uuid4().hex[:4]}", "category_id": cat.json()["id"], "price": 20, "stock_quantity": 5})
+    assert p.status_code == 201, p.text
+    _sql("UPDATE products SET status = 'approved' WHERE id = :i", i=p.json()["id"])
+    buyer_h, _, _ = _register(client, "Buyer")
+    return {"admin": admin_h, "seller": sh, "store_id": store_id, "product": p.json(), "buyer": buyer_h}
+
+
+def _report(client, h, **body):
+    return client.post("/reports", headers=h, json=body)
+
+
+def test_guests_cannot_report(client, world):
+    r = client.post("/reports", json={"target_type": "product", "target_id": world["product"]["id"], "reason": "spam"})
+    assert r.status_code in (401, 403)
+
+
+def test_report_validation(client, world):
+    b = world["buyer"]
+    assert _report(client, b, target_type="product", target_id=world["product"]["id"], reason="not-a-reason").status_code == 422
+    assert _report(client, b, target_type="product", target_id=str(uuid.uuid4()), reason="spam").status_code == 404
+    assert _report(client, world["seller"], target_type="product", target_id=world["product"]["id"], reason="spam").status_code == 400  # own listing
+    assert _report(client, world["seller"], target_type="store", target_id=world["store_id"], reason="spam").status_code == 400
+
+
+def test_report_is_created_once_per_target(client, world):
+    first = _report(client, world["buyer"], target_type="product", target_id=world["product"]["id"], reason="counterfeit", details="Looks fake")
+    assert first.status_code == 201 and first.json()["status"] == "open" and first.json()["already_reported"] is False
+    again = _report(client, world["buyer"], target_type="product", target_id=world["product"]["id"], reason="spam")
+    assert again.status_code == 201 and again.json()["already_reported"] is True and again.json()["id"] == first.json()["id"]
+
+
+def test_blocking_a_store_round_trip(client, world):
+    b, sid = world["buyer"], world["store_id"]
+    assert client.post(f"/blocks/stores/{sid}", headers=b).status_code == 204
+    assert client.post(f"/blocks/stores/{sid}", headers=b).status_code == 204  # idempotent
+    assert [x["store_id"] for x in client.get("/blocks/stores", headers=b).json()] == [sid]
+    assert client.post(f"/blocks/stores/{sid}", headers=world["seller"]).status_code == 400  # not your own store
+    assert client.delete(f"/blocks/stores/{sid}", headers=b).status_code == 204
+    assert client.get("/blocks/stores", headers=b).json() == []
+    assert client.post(f"/blocks/stores/{uuid.uuid4()}", headers=b).status_code == 404
+
+
+def test_admin_queue_is_admin_only(client, world):
+    assert client.get("/admin/reports", headers=world["buyer"]).status_code == 403
+    assert client.get("/admin/reports", headers=world["seller"]).status_code == 403
+    assert client.get("/admin/reports").status_code in (401, 403)
+
+
+def test_admin_can_hide_the_reported_product(client, world):
+    queue = client.get("/admin/reports", headers=world["admin"], params={"status": "open"}).json()
+    mine = [r for r in queue if r["target_id"] == world["product"]["id"]]
+    assert mine and mine[0]["reason"] == "counterfeit" and mine[0]["reporter_email"]
+
+    wrong = client.put(f"/admin/reports/{mine[0]['id']}", headers=world["admin"], json={"status": "open", "action": "clear_review_comment"})
+    assert wrong.status_code == 400  # action must match the target type
+
+    done = client.put(f"/admin/reports/{mine[0]['id']}", headers=world["admin"], json={"status": "open", "action": "hide_product", "admin_note": "Removed"})
+    assert done.status_code == 200 and done.json()["status"] == "actioned" and done.json()["admin_note"] == "Removed"
+    assert str(_sql("SELECT status FROM products WHERE id = :i", i=world["product"]["id"]).scalar()).endswith("rejected")
+    public = client.get("/products", params={"q": world["product"]["name"]}).json()
+    assert all(item["id"] != world["product"]["id"] for item in public["items"])
+    assert not [r for r in client.get("/admin/reports", headers=world["admin"]).json() if r["id"] == mine[0]["id"]]  # no longer "open"
+
+
+def test_store_report_can_suspend_the_store(client, world):
+    rep = _report(client, world["buyer"], target_type="store", target_id=world["store_id"], reason="scam")
+    assert rep.status_code == 201
+    r = client.put(f"/admin/reports/{rep.json()['id']}", headers=world["admin"], json={"status": "open", "action": "suspend_store"})
+    assert r.status_code == 200 and r.json()["status"] == "actioned"
+    assert str(_sql("SELECT status FROM stores WHERE id = :i", i=world["store_id"]).scalar()).endswith("suspended")
