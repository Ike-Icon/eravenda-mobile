@@ -0,0 +1,70 @@
+"""In-app account deletion (required by Apple App Store and Google Play for apps with account creation).
+
+Flow used by the mobile app:
+  GET  /api/users/me/deletion-check   -> can the account be deleted now, and if not, why
+  POST /api/users/me/delete           -> {"confirm": "DELETE", "password": "..."}  (password only if the account has one)
+The rules for what is removed, anonymised and kept live in app/account_deletion.py.
+"""
+
+import logging
+
+from fastapi import APIRouter, Depends, HTTPException, Request  # type: ignore[reportMissingImports]
+from pydantic import BaseModel, Field  # type: ignore[reportMissingImports]
+from sqlalchemy.orm import Session  # type: ignore[reportMissingImports]
+
+from .. import account_deletion, auth, models, security
+from ..database import get_db
+
+logger = logging.getLogger("eravenda.account_deletion")
+router = APIRouter(prefix="/users/me", tags=["account"])
+
+
+class DeletionCheck(BaseModel):
+    can_delete: bool
+    blockers: list[str]
+    requires_password: bool
+
+
+class DeleteRequest(BaseModel):
+    confirm: str = Field(max_length=20)
+    password: str | None = Field(default=None, max_length=200)
+
+
+@router.get("/deletion-check", response_model=DeletionCheck)
+def deletion_check(db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    blockers = account_deletion.deletion_blockers(db, current_user)
+    return DeletionCheck(can_delete=not blockers, blockers=blockers, requires_password=bool(current_user.password_hash))
+
+
+@router.post("/delete", status_code=204)
+def delete_account(
+    payload: DeleteRequest,
+    request: Request,
+    db: Session = Depends(get_db),
+    current_user: models.User = Depends(auth.get_current_user),
+):
+    security.enforce_rate_limit(request, "delete-account", 5, 3600, key=current_user.id)
+
+    if payload.confirm.strip().upper() != "DELETE":
+        raise HTTPException(status_code=400, detail='Type DELETE to confirm')
+    # 400, not 401: a 401 makes the mobile app treat the session as expired and sign the user out.
+    if current_user.password_hash and not auth.verify_password(payload.password or "", current_user.password_hash):
+        raise HTTPException(status_code=400, detail="That password is not correct")
+
+    blockers = account_deletion.deletion_blockers(db, current_user)
+    if blockers:
+        raise HTTPException(status_code=409, detail=" ".join(blockers))
+
+    original_email = current_user.email
+    first_name = (current_user.full_name or "").strip().split(" ")[0]
+    user_id = current_user.id
+    try:
+        account_deletion.anonymize_account(db, current_user)
+        db.commit()
+    except Exception:
+        db.rollback()
+        logger.exception("Account deletion failed for user %s", user_id)
+        raise HTTPException(status_code=500, detail="We couldn't delete your account. Nothing was changed. Please try again or contact support.")
+
+    logger.info("Account %s deleted by its owner", user_id)  # id only: no personal data in logs
+    account_deletion.send_goodbye_email(original_email, first_name)
diff -ruN a/backend/app/routers/devices.py b/backend/app/routers/devices.py
--- a/backend/app/routers/devices.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/routers/devices.py	2026-11-06 07:34:56.332119822 +0000
@@ -0,0 +1,50 @@
+"""Device registration for push notifications (Expo push tokens)."""
+
+from fastapi import APIRouter, Depends, HTTPException, Request  # type: ignore[reportMissingImports]
+from pydantic import BaseModel, Field  # type: ignore[reportMissingImports]
+from sqlalchemy.orm import Session  # type: ignore[reportMissingImports]
+
+from .. import auth, models, push, security
+from ..database import get_db
+
+router = APIRouter(prefix="/devices", tags=["devices"])
+
+
+class DeviceIn(BaseModel):
+    token: str = Field(min_length=10, max_length=200)
+    platform: str | None = Field(default=None, max_length=20)
+
+
+@router.post("", status_code=204)
+def register_device(
+    payload: DeviceIn,
+    request: Request,
+    db: Session = Depends(get_db),
+    current_user: models.User = Depends(auth.get_current_user),
+):
+    """Idempotent. A token always belongs to the most recent account that registered it, so someone who
+    signs in on a shared phone receives their own notifications, not the previous user's."""
+    security.enforce_rate_limit(request, "register-device", 30, 3600, key=current_user.id)
+    token = payload.token.strip()
+    if not push.is_valid_token(token):
+        raise HTTPException(status_code=400, detail="That is not a valid push token")
+    row = db.query(models.DeviceToken).filter(models.DeviceToken.token == token).first()
+    if row:
+        row.user_id = current_user.id
+        row.platform = payload.platform
+    else:
+        db.add(models.DeviceToken(user_id=current_user.id, token=token, platform=payload.platform))
+    db.commit()
+
+
+@router.post("/unregister", status_code=204)
+def unregister_device(
+    payload: DeviceIn,
+    db: Session = Depends(get_db),
+    current_user: models.User = Depends(auth.get_current_user),
+):
+    """Called on sign-out so a shared phone stops receiving the previous user's notifications."""
+    db.query(models.DeviceToken).filter(
+        models.DeviceToken.token == payload.token.strip(), models.DeviceToken.user_id == current_user.id
+    ).delete(synchronize_session=False)
+    db.commit()
diff -ruN a/backend/app/routers/moderation.py b/backend/app/routers/moderation.py
--- a/backend/app/routers/moderation.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/routers/moderation.py	2026-11-06 07:34:56.332871196 +0000
@@ -0,0 +1,270 @@
+"""Reporting and blocking for user-generated content (App Store guideline 1.2 / Google Play UGC policy).
+
+Buyers
+  POST   /api/reports                    report a product, store or review
+  GET    /api/blocks/stores              stores this user has hidden
+  POST   /api/blocks/stores/{store_id}   hide a store
+  DELETE /api/blocks/stores/{store_id}   unhide it
+Admins (web page: /admin/reports.html)
+  GET /api/admin/reports?status=open     the queue
+  PUT /api/admin/reports/{id}            resolve it, optionally acting on the content
+
+Content is already pre-moderated (stores and products wait for admin approval); this adds the after-the-fact path.
+An email goes to ADMIN_NOTIFICATION_EMAIL for every new report so none sits unseen.
+"""
+
+import logging
+import threading
+from datetime import datetime
+from typing import Literal, Optional
+
+from fastapi import APIRouter, Depends, HTTPException, Query, Request  # type: ignore[reportMissingImports]
+from pydantic import BaseModel, Field  # type: ignore[reportMissingImports]
+from sqlalchemy.orm import Session  # type: ignore[reportMissingImports]
+
+from .. import auth, models, security
+from ..database import get_db
+from ..email_utils import ADMIN_NOTIFICATION_EMAIL, SITE_URL, send_email
+
+logger = logging.getLogger("eravenda.moderation")
+router = APIRouter(tags=["moderation"])
+
+REASONS = ("spam", "counterfeit", "prohibited_item", "inappropriate", "scam", "other")
+REASON_LABEL = {
+    "spam": "Spam or misleading",
+    "counterfeit": "Counterfeit or fake",
+    "prohibited_item": "Illegal or prohibited item",
+    "inappropriate": "Offensive or inappropriate",
+    "scam": "Scam or fraud",
+    "other": "Something else",
+}
+STATUSES = ("open", "reviewing", "actioned", "dismissed")
+
+
+class ReportIn(BaseModel):
+    target_type: Literal["product", "store", "review"]
+    target_id: str = Field(min_length=1, max_length=40)
+    reason: Literal["spam", "counterfeit", "prohibited_item", "inappropriate", "scam", "other"]
+    details: Optional[str] = Field(default=None, max_length=1000)
+
+
+class ReportOut(BaseModel):
+    id: str
+    status: str
+    already_reported: bool = False
+
+
+def _resolve_target(db: Session, target_type: str, target_id: str):
+    """Returns (store_id, owner_user_id, label) for a reportable target, or raises 404."""
+    if target_type == "product":
+        row = db.query(models.Product).filter(models.Product.id == target_id).first()
+        if not row:
+            raise HTTPException(status_code=404, detail="That listing no longer exists")
+        store = db.query(models.Store).filter(models.Store.id == row.store_id).first()
+        return row.store_id, (store.owner_id if store else None), f"Product: {row.name}"
+    if target_type == "store":
+        store = db.query(models.Store).filter(models.Store.id == target_id).first()
+        if not store:
+            raise HTTPException(status_code=404, detail="That store no longer exists")
+        return store.id, store.owner_id, f"Store: {store.store_name}"
+    review = db.query(models.Review).filter(models.Review.id == target_id).first()
+    if not review:
+        raise HTTPException(status_code=404, detail="That review no longer exists")
+    product = db.query(models.Product).filter(models.Product.id == review.product_id).first()
+    return (product.store_id if product else None), review.buyer_id, "Review"
+
+
+def _email_admin_async(subject: str, body: str) -> None:
+    def run():
+        try:
+            send_email(to=ADMIN_NOTIFICATION_EMAIL, subject=subject, body=body)
+        except Exception:
+            logger.exception("Could not email the moderation team")
+
+    threading.Thread(target=run, daemon=True).start()
+
+
+@router.post("/reports", response_model=ReportOut, status_code=201)
+def create_report(
+    payload: ReportIn,
+    request: Request,
+    db: Session = Depends(get_db),
+    current_user: models.User = Depends(auth.get_current_user),
+):
+    security.enforce_rate_limit(request, "report-content", 10, 3600, key=current_user.id)
+    store_id, owner_id, label = _resolve_target(db, payload.target_type, payload.target_id)
+    if owner_id and owner_id == current_user.id:
+        raise HTTPException(status_code=400, detail="You can't report your own content")
+
+    # Reporting the same thing twice should not flood the queue: hand back the earlier report.
+    existing = (
+        db.query(models.ContentReport)
+        .filter(
+            models.ContentReport.reporter_id == current_user.id,
+            models.ContentReport.target_type == payload.target_type,
+            models.ContentReport.target_id == payload.target_id,
+            models.ContentReport.status.in_(("open", "reviewing")),
+        )
+        .first()
+    )
+    if existing:
+        return ReportOut(id=existing.id, status=existing.status, already_reported=True)
+
+    report = models.ContentReport(
+        reporter_id=current_user.id,
+        target_type=payload.target_type,
+        target_id=payload.target_id,
+        store_id=store_id,
+        reason=payload.reason,
+        details=(payload.details or "").strip() or None,
+    )
+    db.add(report)
+    db.commit()
+    db.refresh(report)
+
+    _email_admin_async(
+        f"New content report: {REASON_LABEL[payload.reason]}",
+        f"{label}\nReason: {REASON_LABEL[payload.reason]}\n"
+        f"Details: {report.details or '(none given)'}\n\n"
+        f"Review it here: {SITE_URL}/admin/reports.html\n",
+    )
+    return ReportOut(id=report.id, status=report.status)
+
+
+# ---------------- blocking ----------------
+
+class BlockedStore(BaseModel):
+    store_id: str
+    store_name: str
+
+
+@router.get("/blocks/stores", response_model=list[BlockedStore])
+def list_blocked_stores(db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    rows = (
+        db.query(models.Store.id, models.Store.store_name)
+        .join(models.StoreBlock, models.StoreBlock.store_id == models.Store.id)
+        .filter(models.StoreBlock.user_id == current_user.id)
+        .order_by(models.StoreBlock.created_at.desc())
+        .all()
+    )
+    return [BlockedStore(store_id=r[0], store_name=r[1]) for r in rows]
+
+
+@router.post("/blocks/stores/{store_id}", status_code=204)
+def block_store(store_id: str, db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    store = db.query(models.Store).filter(models.Store.id == store_id).first()
+    if not store:
+        raise HTTPException(status_code=404, detail="Store not found")
+    if store.owner_id == current_user.id:
+        raise HTTPException(status_code=400, detail="You can't block your own store")
+    exists = db.query(models.StoreBlock).filter(models.StoreBlock.user_id == current_user.id, models.StoreBlock.store_id == store_id).first()
+    if not exists:
+        db.add(models.StoreBlock(user_id=current_user.id, store_id=store_id))
+        db.commit()
+
+
+@router.delete("/blocks/stores/{store_id}", status_code=204)
+def unblock_store(store_id: str, db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    db.query(models.StoreBlock).filter(models.StoreBlock.user_id == current_user.id, models.StoreBlock.store_id == store_id).delete(synchronize_session=False)
+    db.commit()
+
+
+# ---------------- admin queue ----------------
+
+admin_router = APIRouter(prefix="/admin/reports", tags=["moderation"], dependencies=[Depends(auth.require_role(models.UserRole.admin))])
+
+
+class AdminReportOut(BaseModel):
+    id: str
+    status: str
+    target_type: str
+    target_id: str
+    target_label: str
+    store_id: Optional[str]
+    store_name: Optional[str]
+    reason: str
+    reason_label: str
+    details: Optional[str]
+    reporter_email: Optional[str]
+    admin_note: Optional[str]
+    created_at: datetime
+
+
+class AdminReportUpdate(BaseModel):
+    status: Literal["open", "reviewing", "actioned", "dismissed"]
+    admin_note: Optional[str] = Field(default=None, max_length=1000)
+    # What to do to the reported content. "none" only records the decision.
+    action: Literal["none", "hide_product", "suspend_store", "clear_review_comment"] = "none"
+
+
+def _label(db: Session, report: models.ContentReport) -> str:
+    try:
+        return _resolve_target(db, report.target_type, report.target_id)[2]
+    except HTTPException:
+        return f"{report.target_type.title()} (since removed)"
+
+
+def _admin_out(db: Session, r: models.ContentReport) -> AdminReportOut:
+    store = db.query(models.Store).filter(models.Store.id == r.store_id).first() if r.store_id else None
+    reporter = db.query(models.User).filter(models.User.id == r.reporter_id).first() if r.reporter_id else None
+    return AdminReportOut(
+        id=r.id, status=r.status, target_type=r.target_type, target_id=r.target_id, target_label=_label(db, r),
+        store_id=r.store_id, store_name=store.store_name if store else None,
+        reason=r.reason, reason_label=REASON_LABEL.get(r.reason, r.reason), details=r.details,
+        reporter_email=reporter.email if reporter else None, admin_note=r.admin_note, created_at=r.created_at,
+    )
+
+
+@admin_router.get("", response_model=list[AdminReportOut])
+def admin_list_reports(
+    status: str = Query("open", description="open | reviewing | actioned | dismissed | all"),
+    limit: int = Query(100, ge=1, le=200),
+    db: Session = Depends(get_db),
+):
+    query = db.query(models.ContentReport)
+    if status != "all":
+        if status not in STATUSES:
+            raise HTTPException(status_code=400, detail="Unknown status")
+        query = query.filter(models.ContentReport.status == status)
+    return [_admin_out(db, r) for r in query.order_by(models.ContentReport.created_at.desc()).limit(limit).all()]
+
+
+@admin_router.put("/{report_id}", response_model=AdminReportOut)
+def admin_resolve_report(
+    report_id: str,
+    payload: AdminReportUpdate,
+    db: Session = Depends(get_db),
+    admin: models.User = Depends(auth.get_current_user),
+):
+    report = db.query(models.ContentReport).filter(models.ContentReport.id == report_id).first()
+    if not report:
+        raise HTTPException(status_code=404, detail="Report not found")
+
+    if payload.action == "hide_product":
+        if report.target_type != "product":
+            raise HTTPException(status_code=400, detail="hide_product only applies to a product report")
+        product = db.query(models.Product).filter(models.Product.id == report.target_id).first()
+        if product:
+            product.status = models.ProductStatus.rejected
+            product.rejection_reason = f"Removed after a report: {REASON_LABEL.get(report.reason, report.reason)}"
+    elif payload.action == "suspend_store":
+        if not report.store_id:
+            raise HTTPException(status_code=400, detail="This report has no store to suspend")
+        store = db.query(models.Store).filter(models.Store.id == report.store_id).first()
+        if store:
+            store.status = models.StoreStatus.suspended
+            store.rejection_reason = f"Suspended after a report: {REASON_LABEL.get(report.reason, report.reason)}"
+    elif payload.action == "clear_review_comment":
+        if report.target_type != "review":
+            raise HTTPException(status_code=400, detail="clear_review_comment only applies to a review report")
+        review = db.query(models.Review).filter(models.Review.id == report.target_id).first()
+        if review:
+            review.comment = None
+
+    report.status = "actioned" if payload.action != "none" and payload.status == "open" else payload.status
+    report.admin_note = (payload.admin_note or "").strip() or None
+    report.reviewed_by = admin.id
+    report.reviewed_at = datetime.utcnow()
+    db.commit()
+    db.refresh(report)
+    return _admin_out(db, report)
diff -ruN a/backend/app/routers/notification_preferences.py b/backend/app/routers/notification_preferences.py
--- a/backend/app/routers/notification_preferences.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/routers/notification_preferences.py	2026-11-06 07:34:56.332835171 +0000
@@ -0,0 +1,45 @@
+"""Per-user notification settings, shared by the mobile app's Notifications screen."""
+
+from fastapi import APIRouter, Depends  # type: ignore[reportMissingImports]
+from pydantic import BaseModel  # type: ignore[reportMissingImports]
+from sqlalchemy.orm import Session  # type: ignore[reportMissingImports]
+
+from .. import auth, models, notifications
+from ..database import get_db
+
+router = APIRouter(prefix="/users/me/notification-preferences", tags=["notifications"])
+
+
+class PreferencesOut(BaseModel):
+    order_updates_email: bool
+    order_updates_push: bool
+    seller_orders_push: bool
+
+
+class PreferencesUpdate(BaseModel):
+    """Every field is optional so the app can send just the switch that changed."""
+    order_updates_email: bool | None = None
+    order_updates_push: bool | None = None
+    seller_orders_push: bool | None = None
+
+
+def _out(p: notifications.Prefs) -> PreferencesOut:
+    return PreferencesOut(order_updates_email=p.order_updates_email, order_updates_push=p.order_updates_push, seller_orders_push=p.seller_orders_push)
+
+
+@router.get("", response_model=PreferencesOut)
+def read_preferences(db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    return _out(notifications.get_prefs(db, current_user.id))
+
+
+@router.put("", response_model=PreferencesOut)
+def update_preferences(payload: PreferencesUpdate, db: Session = Depends(get_db), current_user: models.User = Depends(auth.get_current_user)):
+    row = db.query(models.NotificationPreference).filter(models.NotificationPreference.user_id == current_user.id).first()
+    if not row:
+        row = models.NotificationPreference(user_id=current_user.id, order_updates_email=True, order_updates_push=True, seller_orders_push=True)
+        db.add(row)
+    for field, value in payload.model_dump(exclude_unset=True).items():
+        if value is not None:
+            setattr(row, field, value)
+    db.commit()
+    return _out(notifications.get_prefs(db, current_user.id))
diff -ruN a/backend/app/routers/orders.py b/backend/app/routers/orders.py
--- a/backend/app/routers/orders.py	2026-11-06 07:34:56.324644689 +0000
+++ b/backend/app/routers/orders.py	2026-11-06 07:34:56.332094577 +0000
@@ -3,7 +3,7 @@
