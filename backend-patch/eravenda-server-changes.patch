+    return [part.strip() for part in (raw or "").split(",") if part.strip()]
+
+
+# Google: the WEB client id. The mobile app signs in with the same web client id as its "server" client, so
+# its tokens carry this audience too. Extra comma-separated ids are accepted if you ever need them.
+GOOGLE_CLIENT_ID = parse_client_ids(os.getenv("GOOGLE_CLIENT_ID"))
+# Apple: the website's "Services ID" (e.g. com.eravenda.web) AND the iOS app's bundle id (e.g. com.eravenda.app),
