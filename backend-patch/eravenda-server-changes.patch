+"""Unit test for the multi-audience client-id setting (no network, no database).
+
+    python -m pytest tests/test_social_audiences.py -q
+"""
+import os
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-social-tests-0123456789abcdef")
+
+from app import social_auth  # noqa: E402
+
+
+def test_parse_client_ids():
+    assert social_auth.parse_client_ids(None) == []
+    assert social_auth.parse_client_ids("") == []
+    assert social_auth.parse_client_ids("com.eravenda.web") == ["com.eravenda.web"]
+    assert social_auth.parse_client_ids(" com.eravenda.web , com.eravenda.app ,, ") == ["com.eravenda.web", "com.eravenda.app"]
+
+
+def test_missing_config_is_reported_not_crashed():
+    try:
+        social_auth._verify("x.y.z", "https://example.invalid/keys", {"iss"}, [], "apple")
+    except social_auth.TokenVerificationError as exc:
+        assert "APPLE_CLIENT_ID is not configured" in str(exc)
+    else:
+        raise AssertionError("expected TokenVerificationError")
diff -ruN a/frontend/templates/admin/reports.html b/frontend/templates/admin/reports.html
--- a/frontend/templates/admin/reports.html	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/templates/admin/reports.html	2026-11-06 07:34:56.338932786 +0000
@@ -0,0 +1,101 @@
+{% extends "base.html" %}
+{% block title %}Content reports — Eravenda Admin{% endblock %}
+{% block robots_meta %}noindex, nofollow{% endblock %}
+{% block content %}
+<div class="bg-slate-50 min-h-full">
+<section class="max-w-4xl mx-auto px-4 py-8">
+
+  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
+    <div>
+      <p class="text-brand-700 text-sm font-bold tracking-wider">ERAVENDA ADMINISTRATION</p>
+      <h1 class="font-head text-2xl sm:text-3xl font-bold mt-1">Content reports</h1>
+      <p class="text-slate-500 mt-2 text-sm">Products, stores and reviews that buyers reported from the app. Review each one, act on it if it breaks the Terms, and record what you decided.</p>
+    </div>
+    <div class="flex items-center gap-2 shrink-0">
+      <select id="statusFilter" class="border border-slate-300 bg-white rounded-lg px-3 py-2 text-sm font-semibold">
+        <option value="open">Open</option>
+        <option value="reviewing">Reviewing</option>
+        <option value="actioned">Actioned</option>
+        <option value="dismissed">Dismissed</option>
+        <option value="all">All</option>
+      </select>
+      <a href="/admin/dashboard.html" class="border border-slate-300 bg-white px-4 py-2 rounded-lg text-sm font-semibold">Dashboard</a>
+    </div>
+  </div>
+
+  <p id="message" class="text-sm text-slate-500 mb-4"></p>
+  <div id="list" class="space-y-4"></div>
+
+</section>
+</div>
+
+<script>
+if (!Auth.isLoggedIn()) location.href = '/login?next=/admin/reports.html';
+const _u = Auth.getUser(); if (!_u || _u.role !== 'admin') location.href = '/';
+
+const esc = s => String(s ?? '').replace(/[&<>"'`]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;','`':'&#96;'}[c]));
+const listEl = document.getElementById('list');
+const msgEl = document.getElementById('message');
+const filterEl = document.getElementById('statusFilter');
+
+const badge = s => ({ open: 'bg-amber-100 text-amber-800', reviewing: 'bg-sky-100 text-sky-800', actioned: 'bg-emerald-100 text-emerald-800', dismissed: 'bg-slate-200 text-slate-700' }[s] || 'bg-slate-100');
+
+function card(r) {
+  const btn = (action, status, label, cls) =>
+    `<button data-id="${esc(r.id)}" data-action="${action}" data-status="${status}" class="report-btn ${cls} px-3 py-1.5 rounded-lg text-xs font-bold">${label}</button>`;
+  const actions = [];
+  if (r.target_type === 'product') actions.push(btn('hide_product', 'actioned', 'Hide product', 'bg-red-600 text-white'));
+  if (r.target_type === 'review') actions.push(btn('clear_review_comment', 'actioned', 'Clear comment', 'bg-red-600 text-white'));
+  if (r.store_id) actions.push(btn('suspend_store', 'actioned', 'Suspend store', 'bg-red-800 text-white'));
+  actions.push(btn('none', 'reviewing', 'Mark reviewing', 'border border-slate-300 bg-white'));
+  actions.push(btn('none', 'dismissed', 'Dismiss', 'border border-slate-300 bg-white'));
+  return `
+  <article class="bg-white border border-slate-200 rounded-2xl p-5">
+    <div class="flex items-start justify-between gap-3">
+      <div>
+        <h2 class="font-bold text-slate-900">${esc(r.target_label)}</h2>
+        <p class="text-xs text-slate-500 mt-0.5">${r.store_name ? 'Store: ' + esc(r.store_name) + ' · ' : ''}Reported ${new Date(r.created_at).toLocaleString()}${r.reporter_email ? ' by ' + esc(r.reporter_email) : ''}</p>
+      </div>
+      <span class="text-xs font-bold px-2 py-1 rounded-full ${badge(r.status)}">${esc(r.status)}</span>
+    </div>
+    <p class="mt-3 text-sm"><strong>${esc(r.reason_label)}</strong>${r.details ? ' — ' + esc(r.details) : ''}</p>
+    ${r.admin_note ? `<p class="mt-2 text-sm text-slate-600"><em>Admin note:</em> ${esc(r.admin_note)}</p>` : ''}
+    <div class="mt-4 space-y-3">
+      <input id="note-${esc(r.id)}" type="text" maxlength="1000" placeholder="Note about your decision (optional)" value="" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm">
+      <div class="flex flex-wrap gap-2">${actions.join('')}</div>
+    </div>
+  </article>`;
+}
+
+async function load() {
+  msgEl.textContent = 'Loading…';
+  try {
+    const rows = await apiFetch('/admin/reports?status=' + encodeURIComponent(filterEl.value));
+    msgEl.textContent = rows.length ? `${rows.length} report(s)` : 'Nothing here. All caught up.';
+    listEl.innerHTML = rows.map(card).join('');
+  } catch (e) {
+    msgEl.textContent = e.message;
+    listEl.innerHTML = '';
+  }
+}
+
+listEl.addEventListener('click', async (ev) => {
+  const b = ev.target.closest('.report-btn');
+  if (!b) return;
+  const { id, action, status } = b.dataset;
+  if (action !== 'none' && !confirm('This changes live content and cannot be undone from here. Continue?')) return;
+  b.disabled = true;
+  try {
+    const note = document.getElementById('note-' + id).value;
+    await apiFetch('/admin/reports/' + encodeURIComponent(id), { method: 'PUT', body: { status, action, admin_note: note || null } });
+    await load();
+  } catch (e) {
+    alert(e.message);
+    b.disabled = false;
+  }
+});
+
+filterEl.addEventListener('change', load);
+load();
+</script>
+{% endblock %}
