+"""End-to-end checks for in-app account deletion (anonymisation).
+
+Runs against a real PostgreSQL, like tests/test_wholesale.py (set DATABASE_URL to a throwaway database):
+
+    DATABASE_URL=postgresql://localhost:5432/eravenda_test SECRET_KEY=test \
+        python -m pytest tests/test_account_deletion.py -q
+
+NOTE: written against the real routes and models but not yet executed (the authoring sandbox had no PostgreSQL).
+Run it once before shipping and fix any fixture detail that differs on your database.
+"""
+import os
+import uuid
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import text
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-account-deletion-tests")
+
+from app.database import engine  # noqa: E402
+from app.main import app  # noqa: E402
+
+PWD = "Passw0rd!123"
+
+
+def _sql(query, **params):
+    with engine.begin() as conn:
+        return conn.execute(text(query), params)
+
+
+@pytest.fixture(scope="module")
+def client():
+    with TestClient(app, base_url="http://testserver/api") as c:
+        yield c
+
+
+def _register(client, name):
+    email = f"{name}-{uuid.uuid4().hex[:6]}@example.com"
+    r = client.post("/auth/register", json={"full_name": name, "email": email, "password": PWD})
+    assert r.status_code in (200, 201), r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}, r.json()["user"]["id"], email
+
+
+def _relogin(client, email, role, user_id):
+    _sql("UPDATE users SET role = :r WHERE id = :i", r=role, i=user_id)
+    r = client.post("/auth/login", data={"username": email, "password": PWD})
+    assert r.status_code == 200, r.text
+    return {"Authorization": f"Bearer {r.json()['access_token']}"}
+
+
+@pytest.fixture(scope="module")
+def shop(client):
+    """An admin-made category plus one approved seller with one approved product."""
+    admin_h, admin_id, admin_email = _register(client, "Admin")
+    admin_h = _relogin(client, admin_email, "admin", admin_id)
+    cat = client.post("/categories", headers=admin_h, json={"name": f"Cat {uuid.uuid4().hex[:4]}"})
+    assert cat.status_code == 201, cat.text
+
+    h, uid, email = _register(client, "Seller")
+    r = client.post("/stores", headers=h, json={"store_name": f"Shop {uuid.uuid4().hex[:4]}", "region": "Bono", "city": "Sunyani"})
+    assert r.status_code == 201, r.text
+    _sql("UPDATE stores SET status = 'approved' WHERE id = :i", i=r.json()["id"])
+    h = _relogin(client, email, "seller", uid)
+    p = client.post("/products", headers=h, json={"name": "Test shoe", "category_id": cat.json()["id"], "price": 50, "stock_quantity": 100})
+    assert p.status_code == 201, p.text
+    _sql("UPDATE products SET status = 'approved' WHERE id = :i", i=p.json()["id"])
+    return {"cat": cat.json()["id"], "product_id": p.json()["id"]}
+
+
+def _address(client, h):
+    r = client.post("/auth/addresses", headers=h, json={"recipient_name": "Ama Mensah", "phone": "0240000000", "region": "Bono", "city": "Sunyani", "landmark": "Blue gate"})
+    assert r.status_code in (200, 201), r.text
+    return r.json()["id"]
+
+
+def test_check_for_a_new_buyer(client):
+    h, _, _ = _register(client, "Fresh")
+    r = client.get("/users/me/deletion-check", headers=h)
+    assert r.status_code == 200
+    assert r.json() == {"can_delete": True, "blockers": [], "requires_password": True}
+
+
+def test_confirmation_word_and_password_are_required(client):
+    h, _, _ = _register(client, "Careful")
+    assert client.post("/users/me/delete", headers=h, json={"confirm": "nope", "password": PWD}).status_code == 400
+    wrong = client.post("/users/me/delete", headers=h, json={"confirm": "DELETE", "password": "not-the-password"})
+    assert wrong.status_code == 400  # not 401, which would sign the app user out
+    assert client.get("/auth/me", headers=h).status_code == 200  # still alive
+
+
+def test_open_order_blocks_deletion_until_it_is_cancelled(client, shop):
+    h, _, _ = _register(client, "Shopper")
+    addr = _address(client, h)
+    client.post("/cart/items", headers=h, json={"product_id": shop["product_id"], "quantity": 1})
+    order = client.post("/orders/checkout", headers=h, json={"address_id": addr, "is_pickup": True})
+    assert order.status_code in (200, 201), order.text
+    order_id = order.json()[0]["id"]
+
+    check = client.get("/users/me/deletion-check", headers=h).json()
+    assert check["can_delete"] is False and "in progress" in check["blockers"][0]
+    assert client.post("/users/me/delete", headers=h, json={"confirm": "DELETE", "password": PWD}).status_code == 409
+
+    assert client.post(f"/orders/{order_id}/cancel", headers=h).status_code == 200
+    assert client.get("/users/me/deletion-check", headers=h).json()["can_delete"] is True
+
+
+def test_deletion_anonymises_the_account_and_keeps_order_records(client, shop):
+    h, uid, email = _register(client, "Leaver")
+    used = _address(client, h)
+    unused = _address(client, h)
+    client.post("/cart/items", headers=h, json={"product_id": shop["product_id"], "quantity": 1})
+    order = client.post("/orders/checkout", headers=h, json={"address_id": used, "is_pickup": True}).json()[0]
+    assert client.post(f"/orders/{order['id']}/cancel", headers=h).status_code == 200  # finished orders do not block
+    client.post("/devices", headers=h, json={"token": "ExponentPushToken[abc123]", "platform": "ios"})
+    client.put("/users/me/notification-preferences", headers=h, json={"order_updates_email": False})
+    client.post(f"/wishlist/{shop['product_id']}", headers=h)
+
+    assert client.post("/users/me/delete", headers=h, json={"confirm": "delete", "password": PWD}).status_code == 204
+
+    user = _sql("SELECT full_name, email, phone, password_hash, is_active, is_verified FROM users WHERE id = :i", i=uid).one()
+    assert user.full_name == "Deleted user" and user.email.startswith("deleted-") and user.email != email
+    assert user.phone is None and user.password_hash is None and user.is_active is False and user.is_verified is False
+
+    # records the business must keep are still there, but identify nobody
+    assert _sql("SELECT count(*) FROM orders WHERE id = :i AND buyer_id = :u", i=order["id"], u=uid).scalar() == 1
+    kept = _sql("SELECT recipient_name, phone, landmark FROM addresses WHERE id = :i", i=used).one()
+    assert kept.recipient_name == "Deleted user" and kept.landmark is None
+    # everything else personal is gone
+    assert _sql("SELECT count(*) FROM addresses WHERE id = :i", i=unused).scalar() == 0
+    assert _sql("SELECT count(*) FROM device_tokens WHERE user_id = :u", u=uid).scalar() == 0
+    assert _sql("SELECT count(*) FROM notification_preferences WHERE user_id = :u", u=uid).scalar() == 0
+    assert _sql("SELECT count(*) FROM wishlists WHERE user_id = :u", u=uid).scalar() == 0
+
+    # the account can no longer be used
+    assert client.post("/auth/login", data={"username": email, "password": PWD}).status_code in (400, 401, 403)
+    assert client.get("/auth/me", headers=h).status_code in (401, 403)
+
+
+def test_seller_deletion_closes_the_store_and_hides_products(client, shop):
+    h, uid, email = _register(client, "Closer")
+    r = client.post("/stores", headers=h, json={"store_name": f"Closing {uuid.uuid4().hex[:4]}", "description": "private text", "region": "Bono", "city": "Sunyani"})
+    assert r.status_code == 201, r.text
+    store_id = r.json()["id"]
+    _sql("UPDATE stores SET status = 'approved' WHERE id = :i", i=store_id)
+    h = _relogin(client, email, "seller", uid)
+    p = client.post("/products", headers=h, json={"name": "Closing item", "category_id": shop["cat"], "price": 10, "stock_quantity": 5})
+    assert p.status_code == 201, p.text
+    _sql("UPDATE products SET status = 'approved' WHERE id = :i", i=p.json()["id"])
+
+    assert client.post("/users/me/delete", headers=h, json={"confirm": "DELETE", "password": PWD}).status_code == 204
+
+    store = _sql("SELECT store_name, description, status FROM stores WHERE id = :i", i=store_id).one()
+    assert store.store_name == "Closed store" and store.description is None and str(store.status).endswith("suspended")
+    product = _sql("SELECT status, stock_quantity FROM products WHERE id = :i", i=p.json()["id"]).one()
+    assert str(product.status).endswith("out_of_stock") and product.stock_quantity == 0
+    public = client.get("/products", params={"q": "Closing item"}).json()
+    assert all(item["id"] != p.json()["id"] for item in public["items"])
