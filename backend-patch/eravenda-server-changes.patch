diff -ruN a/backend/app/account_deletion.py b/backend/app/account_deletion.py
--- a/backend/app/account_deletion.py	1970-01-01 00:00:00.000000000 +0000
+++ b/backend/app/account_deletion.py	2026-11-06 07:34:56.334092603 +0000
@@ -0,0 +1,191 @@
+"""Account deletion by anonymisation.
+
+Why not a hard delete?  Orders reference the buyer, the store and the delivery address, and payments reference the
+order. The business has to keep those records (tax, accounting, disputes; the privacy policy says up to six years),
+and the database rightly refuses to delete a user who has them (the admin "delete user" endpoint fails for the same reason).
+
+So deleting an account means:
+  * REMOVED: saved addresses not used by an order, cart, wishlist, store follows, store blocks, push tokens, notification
+    preferences, newsletter signup and contact-form messages sent from the account's email, review comments,
+    and every personal field on the user (name, email, phone, password, sign-in links, avatar, location).
+  * ANONYMISED: addresses used by past orders (name and phone blanked, street-level details removed),
+    the seller's store (renamed "Closed store", description/logo/banner/registration number removed, suspended)
+    and its products (hidden, stock 0).
+  * KEPT: the user row itself (as "Deleted user", inactive, unable to sign in), orders, order items, payments,
+    receipts, review ratings (so product rating averages stay honest), payout records and content reports the user
+    filed (moderation records; they keep pointing at the anonymised user).
+
+Nothing here commits: the caller commits once so the whole deletion succeeds or fails together.
+"""
+
+import logging
+import threading
+
+from sqlalchemy import func  # type: ignore[reportMissingImports]
+
+from . import models
+from .email_utils import SITE_URL, send_email
+
+logger = logging.getLogger("eravenda.account_deletion")
+
+DELETED_NAME = "Deleted user"
+ACTIVE_ORDER_STATUSES = (
+    models.OrderStatus.pending,
+    models.OrderStatus.paid,
+    models.OrderStatus.processing,
+    models.OrderStatus.shipped,
+)
+FINISHED_BOOKINGS = (models.ServiceBookingStatus.released, models.ServiceBookingStatus.cancelled)
+OPEN_PAYOUTS = (models.PayoutStatus.pending, models.PayoutStatus.processing)
+
+
+def _plural(n: int, word: str) -> str:
+    return f"{n} {word}" + ("" if n == 1 else "s")
+
+
+def deletion_blockers(db, user) -> list[str]:
+    """Plain-language reasons this account cannot be deleted right now (empty list = it can)."""
+    role = user.role.value if hasattr(user.role, "value") else str(user.role)
+    if role not in ("buyer", "seller"):
+        return ["This type of account can't be deleted in the app. Please contact EraVenda support."]
+
+    has_profile = (
+        db.query(models.DeliveryProfile.id).filter(models.DeliveryProfile.user_id == user.id).first()
+        or db.query(models.HandymanProfile.id).filter(models.HandymanProfile.user_id == user.id).first()
+    )
+    if has_profile:
+        return ["This account has a delivery or professional-services profile. Please contact EraVenda support to close it."]
+
+    blockers: list[str] = []
+
+    buying = db.query(func.count(models.Order.id)).filter(
+        models.Order.buyer_id == user.id, models.Order.status.in_(ACTIVE_ORDER_STATUSES)
+    ).scalar() or 0
+    if buying:
+        blockers.append(
+            f"You have {_plural(buying, 'order')} in progress. Cancel any unpaid orders, "
+            "or wait until they are delivered or cancelled."
+        )
+
+    bookings = db.query(func.count(models.ServiceBooking.id)).filter(
+        models.ServiceBooking.client_id == user.id, models.ServiceBooking.status.notin_(FINISHED_BOOKINGS)
+    ).scalar() or 0
+    if bookings:
+        blockers.append(f"You have {_plural(bookings, 'service booking')} that isn't finished yet.")
+
+    store = db.query(models.Store).filter(models.Store.owner_id == user.id).first()
+    if store:
+        selling = db.query(func.count(models.Order.id)).filter(
+            models.Order.store_id == store.id, models.Order.status.in_(ACTIVE_ORDER_STATUSES)
+        ).scalar() or 0
+        if selling:
+            blockers.append(
+                f"Your store has {_plural(selling, 'order')} in progress. "
+                "Finish or cancel them before deleting your account."
+            )
+        payouts = db.query(func.count(models.Payout.id)).filter(
+            models.Payout.store_id == store.id, models.Payout.status.in_(OPEN_PAYOUTS)
+        ).scalar() or 0
+        if payouts:
+            blockers.append(f"Your store has {_plural(payouts, 'payout')} still being processed.")
+    return blockers
+
+
+def anonymize_account(db, user) -> None:
+    """Apply the rules in the module docstring. Does NOT commit."""
+    email = (user.email or "").strip().lower()
+
+    # --- addresses: orders keep pointing at theirs, so scrub those and delete the rest
+    used = {row[0] for row in db.query(models.Order.address_id).filter(models.Order.buyer_id == user.id).all()}
+    for address in db.query(models.Address).filter(models.Address.user_id == user.id).all():
+        if address.id in used:
+            address.label = None
+            address.recipient_name = DELETED_NAME
+            address.phone = "-"
+            address.area = None
+            address.sub_town = None
+            address.landmark = None
+            address.is_default = False
+        else:
+            db.delete(address)
+
+    # --- cart (items cascade), wishlist, device + preference rows
+    cart = db.query(models.Cart).filter(models.Cart.user_id == user.id).first()
+    if cart:
+        db.delete(cart)
+    db.query(models.Wishlist).filter(models.Wishlist.user_id == user.id).delete(synchronize_session=False)
+    db.query(models.DeviceToken).filter(models.DeviceToken.user_id == user.id).delete(synchronize_session=False)
+    db.query(models.StoreBlock).filter(models.StoreBlock.user_id == user.id).delete(synchronize_session=False)
+    db.query(models.NotificationPreference).filter(models.NotificationPreference.user_id == user.id).delete(synchronize_session=False)
+
+    # --- store follows, then keep each store's denormalised follower_count honest
+    followed = [row[0] for row in db.query(models.StoreFollow.store_id).filter(models.StoreFollow.user_id == user.id).all()]
+    db.query(models.StoreFollow).filter(models.StoreFollow.user_id == user.id).delete(synchronize_session=False)
+    for store_id in followed:
+        store = db.query(models.Store).filter(models.Store.id == store_id).first()
+        if store:
+            store.follower_count = db.query(func.count(models.StoreFollow.id)).filter(models.StoreFollow.store_id == store_id).scalar() or 0
+
+    # --- review comments can contain personal details; the star rating stays so averages are not rewritten
+    db.query(models.Review).filter(models.Review.buyer_id == user.id).update({"comment": None}, synchronize_session=False)
+
+    # --- records keyed only by email address
+    if email:
+        db.query(models.NewsletterSubscriber).filter(func.lower(models.NewsletterSubscriber.email) == email).delete(synchronize_session=False)
+        db.query(models.ContactMessage).filter(func.lower(models.ContactMessage.email) == email).delete(synchronize_session=False)
+
+    # --- the seller's store and products
+    store = db.query(models.Store).filter(models.Store.owner_id == user.id).first()
+    if store:
+        db.query(models.Product).filter(models.Product.store_id == store.id).update(
+            {"status": models.ProductStatus.out_of_stock, "stock_quantity": 0}, synchronize_session=False
+        )
+        store.store_name = "Closed store"
+        store.slug = f"closed-{store.id[:8]}"
+        store.description = None
+        store.logo_url = None
+        store.banner_url = None
+        store.business_registration_number = None
+        store.sub_town = None
+        store.status = models.StoreStatus.suspended
+        store.rejection_reason = "Account deleted by its owner"
+
+    # --- finally the person: the row stays (orders point at it) but identifies nobody and cannot sign in
+    user.full_name = DELETED_NAME
+    user.email = f"deleted-{user.id}@deleted.eravenda.invalid"
+    user.phone = None
+    user.password_hash = None
+    user.oauth_provider = None
+    user.oauth_sub = None
+    user.avatar_url = None
+    user.region = None
+    user.city = None
+    user.sub_town = None
+    user.is_active = False
+    user.is_verified = False
+
+
+def send_goodbye_email(to: str, first_name: str) -> None:
+    """Confirmation to the ORIGINAL address (it is gone from the account by now). Background thread, never raises."""
+    if not to:
+        return
+
+    def run():
+        try:
+            send_email(
+                to=to,
+                subject="Your EraVenda account has been deleted",
+                body=(
+                    f"Hi {first_name or 'there'},\n\n"
+                    "Your EraVenda account has been deleted and your personal details have been removed.\n\n"
+                    "We keep order and payment records for as long as the law requires, without your name or contact details "
+                    "linked to your account. Your saved addresses, wishlist, cart and notification settings are gone.\n\n"
+                    "If you did not ask for this, contact us right away:\n"
+                    f"{SITE_URL}/contact\n\n"
+                    "Thank you for using EraVenda.\n"
+                ),
+            )
+        except Exception:
+            logger.exception("Could not send the account-deletion confirmation email")
+
+    threading.Thread(target=run, daemon=True).start()
