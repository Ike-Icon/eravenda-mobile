+"""Unit tests for push.py that need no database or network.
+
+    SECRET_KEY=a-long-random-test-secret-of-32-chars-or-more python -m pytest tests/test_push.py -q
+"""
+import os
+
+os.environ.setdefault("SECRET_KEY", "test-secret-key-for-push-tests-0123456789abcdef")
+
+from app import push  # noqa: E402
+
+
+class _FakeQuery:
+    def __init__(self, rows):
+        self.rows = rows
+
+    def filter(self, *_a, **_k):
+        return self
+
+    def all(self):
+        return self.rows
+
+
+class _FakeDb:
+    def __init__(self, tokens):
+        self.tokens = tokens
+
+    def query(self, *_a, **_k):
+        return _FakeQuery([(t,) for t in self.tokens])
+
+
+def test_token_validation():
+    assert push.is_valid_token("ExponentPushToken[abc123_-XYZ]")
+    assert push.is_valid_token("ExpoPushToken[abc123]")
+    assert not push.is_valid_token("not-a-token")
+    assert not push.is_valid_token("")
+    assert not push.is_valid_token(None)
+
+
+def test_notify_sends_one_message_per_device(monkeypatch):
+    sent = []
+
+    class _Immediate:
+        def __init__(self, target, args, daemon):
+            self.target, self.args = target, args
+
+        def start(self):
+            self.target(*self.args)
+
+    monkeypatch.setattr(push.threading, "Thread", _Immediate)
+    monkeypatch.setattr(push, "_send", lambda messages: sent.extend(messages))
+    push.notify_users(_FakeDb(["ExponentPushToken[a]", "ExponentPushToken[b]"]), ["u1"], "Hi", "There", {"x": 1})
+    assert [m["to"] for m in sent] == ["ExponentPushToken[a]", "ExponentPushToken[b]"]
+    assert sent[0]["title"] == "Hi" and sent[0]["data"] == {"x": 1}
+
+
+def test_notify_does_nothing_without_tokens_or_when_disabled(monkeypatch):
+    monkeypatch.setattr(push.threading, "Thread", lambda *a, **k: (_ for _ in ()).throw(AssertionError("no thread expected")))
+    push.notify_users(_FakeDb([]), ["u1"], "Hi", "There")
+    monkeypatch.setenv("PUSH_NOTIFICATIONS_ENABLED", "false")
+    push.notify_users(_FakeDb(["ExponentPushToken[a]"]), ["u1"], "Hi", "There")
diff -ruN a/backend/tests/test_social_audiences.py b/backend/tests/test_social_audiences.py
