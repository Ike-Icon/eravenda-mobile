# Copy to .env. Must point at your deployed EraVenda API, INCLUDING the /api suffix.
# On a physical phone, "localhost" will not work: use your Render URL or your computer's LAN IP.
EXPO_PUBLIC_API_URL=https://YOUR-EXPO-API-HOST/api

# Cloudinary unsigned upload (same values your website uses in frontend/js/config.js).
# These are public client settings, not secrets. Never put the Cloudinary API secret here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=ni2pcrua
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=eravenda
